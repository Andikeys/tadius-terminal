PORT=4001

# Origin allowed to call this API / open the terminal WebSocket
CLIENT_ORIGIN=http://localhost:3010

# Leave both blank to use the platform default (Unix socket on
# macOS/Linux, named pipe on Windows). Set DOCKER_HOST if you've enabled
# Docker Desktop's "Expose daemon on tcp://localhost:2375 without TLS"
# option and want to connect over TCP instead.
DOCKER_HOST=
DOCKER_SOCKET_PATH=

TADIUS_BASE_IMAGE=tadius-base:latest

# Docker-in-Docker sidecar image — pulled from Docker Hub automatically on
# first use, not something you build yourself. Pin to a specific tag if you
# need to match a particular Docker Engine version inside labs.
TADIUS_DIND_IMAGE=docker:27-dind
